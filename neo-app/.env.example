# ── LLM (Ollama) ───────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# ── Embedding & re-ranking models ──────────────────────────────────────────────
# Do NOT change EMBED_MODEL after first ingest without re-ingesting all documents.
EMBED_MODEL=paraphrase-multilingual-MiniLM-L12-v2
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ── Documents ──────────────────────────────────────────────────────────────────
# Absolute or relative path to docs/ folder containing product sub-folders.
# Defaults to ../docs (i.e. the original docs/ next to neo-app/).
DOCUMENTS_PATH=../docs

# ── Retrieval pipeline ─────────────────────────────────────────────────────────
TOP_K_RETRIEVAL=15        # Initial candidates fetched by cosine similarity
TOP_K_RERANK=5            # Passed to re-ranker
TOP_K_ANSWER=3            # Final chunks sent to LLM

# ── Hallucination guard thresholds ─────────────────────────────────────────────
# Do NOT raise RERANK_THRESHOLD above -0.25 without re-running gate tests.
SIMILARITY_THRESHOLD=0.30
RERANK_THRESHOLD=-0.50

# ── Chunking ───────────────────────────────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=80

# ── Translation timeout (seconds) ─────────────────────────────────────────────
TRANSLATION_TIMEOUT=45

# ── Server ─────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
