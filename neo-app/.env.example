# ── Azure OpenAI ───────────────────────────────────────────────────────────────
# Get these from: Azure Portal → your OpenAI resource → Keys and Endpoint
AZURE_OPENAI_ENDPOINT=https://<your-openai-name>.openai.azure.com/
AZURE_OPENAI_API_KEY=<your-api-key>
AZURE_OPENAI_EMBED_MODEL=text-embedding-3-small
AZURE_OPENAI_CHAT_MODEL=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-02-01

# ── Azure AI Search ────────────────────────────────────────────────────────────
# Get these from: Azure Portal → your Search resource → Keys
AZURE_SEARCH_ENDPOINT=https://<your-search-name>.search.windows.net
AZURE_SEARCH_KEY=<your-search-admin-key>
AZURE_SEARCH_INDEX=airplus-assist

# ── Azure Blob Storage ─────────────────────────────────────────────────────────
# Get from: Azure Portal → your Storage account → Access keys → Connection string
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=<...>;AccountKey=<...>;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER=content

# ── Documents ──────────────────────────────────────────────────────────────────
# Local path to docs/ folder. Ingest reads from here and uploads to Azure AI Search.
DOCUMENTS_PATH=../docs

# ── Retrieval pipeline ─────────────────────────────────────────────────────────
TOP_K_RETRIEVAL=15        # Candidates from Azure AI Search vector query
TOP_K_RERANK=5            # Top results after semantic ranking
TOP_K_ANSWER=3            # Final chunks sent to GPT

# ── Hallucination guard (Azure Semantic Ranking: 0–4 scale) ───────────────────
# Do NOT raise RERANK_THRESHOLD above 1.5 without re-running gate tests.
RERANK_THRESHOLD=0.8
# Two-stage: Stage 1 must score >= this to answer directly (skip Stage 2 guides)
STAGE1_QUALITY_THRESHOLD=2.0

# ── Chunking ───────────────────────────────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=80

# ── Server ─────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
