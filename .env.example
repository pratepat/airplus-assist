APP_NAME=AirPlus Assist
OLLAMA_MODEL=phi3:mini

# Ollama URL
# Option A (recommended for Mac — uses Metal GPU):
#   Run "ollama serve" in a separate terminal first
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Option B (Docker Ollama — CPU only on Mac, slower):
# OLLAMA_BASE_URL=http://ollama:11434
CHROMA_HOST=chromadb
CHROMA_PORT=8000
CHROMA_COLLECTION=airplus_assist
EMBED_MODEL=paraphrase-multilingual-MiniLM-L12-v2
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
CHUNK_SIZE=512
CHUNK_OVERLAP=80
TOP_K_RETRIEVAL=10
TOP_K_RERANK=3
SIMILARITY_THRESHOLD=0.40
RERANK_THRESHOLD=-0.50
TRANSLATION_TIMEOUT=45   # seconds, increase if Ollama is slow under concurrent load
API_HOST=http://api:8001
